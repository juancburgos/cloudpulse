# Environment variables for CloudPulse (copy to .env and fill in)

# Region label surfaced by the API and displayed in the Android app.
# Any string works; naming it like a cloud region keeps the demo honest about where it runs.
REGION=us-east-1

# Version reported by /healthz and /api/v1/status. Keep in sync with the Android versionName.
APP_VERSION=1.0.0

# Database password. Generate one, never commit it:
#   openssl rand -base64 24
DB_PASSWORD=change-me-before-deploying

# Optional: full DSN override (otherwise the compose file builds it from DB_PASSWORD).
# DATABASE_URL=postgresql://cloudpulse:change-me@db:5432/cloudpulse
